{
  // Las rutas y el nombre del plugin se configuran en settings.json
  "version": "2.0.0",
  "tasks": [
    {
      // Tarea principal: compilar y desplegar al servidor local.
      // La logica vive en scripts/deploy-local.ps1 para poder ejecutarla
      // tambien a mano y para que sea legible: como comando inline habia
      // crecido hasta ser imposible de revisar.
      "label": "deploy",
      "type": "shell",
      "options": {
        "shell": {
          "executable": "powershell.exe",
          "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File"]
        }
      },
      "command": "${workspaceFolder}/scripts/deploy-local.ps1",
      "args": ["-DataDir", "${config:jellyfinDataDir}"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      // Solo compila, sin desplegar. Util para comprobar rapido que algo
      // compila sin pasar por el UAC del despliegue.
      "label": "build",
      "command": "dotnet",
      "type": "shell",
      "args": [
        "publish",
        "--configuration=Debug",
        "${workspaceFolder}/${config:pluginName}.sln",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "group": "build",
      "presentation": {
        "reveal": "silent"
      },
      "problemMatcher": "$msCompile"
    },
    {
      // Sigue el log del servidor en vivo. Util para ver los mensajes
      // que emite la tarea programada del plugin.
      "label": "tail-log",
      "type": "shell",
      "isBackground": true,
      "options": {
        "shell": {
          "executable": "powershell.exe",
          "args": ["-NoProfile", "-Command"]
        }
      },
      "command": "Get-ChildItem '${config:jellyfinDataDir}/log' -Filter 'log_*.log' | Sort-Object LastWriteTime -Descending | Select-Object -First 1 | ForEach-Object { Get-Content $_.FullName -Wait -Tail 30 }",
      "problemMatcher": []
    },
    {
      // Igual que tail-log pero solo las lineas del plugin. Jellyfin escribe
      // mucho ruido (escaneos, EF Core, ffmpeg) que entierra lo nuestro.
      "label": "tail-log-plugin",
      "type": "shell",
      "isBackground": true,
      "options": {
        "shell": {
          "executable": "powershell.exe",
          "args": ["-NoProfile", "-Command"]
        }
      },
      "command": "Get-ChildItem '${config:jellyfinDataDir}/log' -Filter 'log_*.log' | Sort-Object LastWriteTime -Descending | Select-Object -First 1 | ForEach-Object { Get-Content $_.FullName -Wait -Tail 50 } | Select-String -Pattern 'ScheduledAccess|Instantanea|Restriccion aplicada|Politica restaurada'",
      "problemMatcher": []
    }
  ]
}
