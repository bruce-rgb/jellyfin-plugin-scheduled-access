# Normaliza los finales de linea: LF en el repositorio, sea cual sea el SO
# de quien contribuye. Sin esto, un colaborador en Windows genera diffs
# completos por cambios invisibles de CRLF.
* text=auto eol=lf

# Estos si necesitan CRLF al extraerse en Windows.
*.ps1  text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf
*.sln  text eol=crlf

# Binarios: que git no intente normalizarlos nunca.
*.dll  binary
*.pdb  binary
*.zip  binary
*.png  binary
*.jpg  binary
